# ==============================================================================
# TEMPLATE VARIABEL LINGKUNGAN (ENVIRONMENT VARIABLES)
# Proyek: Open Source (MKIPS030524) - Kelompok 4 SI52
# ==============================================================================

# Alamat host basis data (biasanya localhost atau 127.0.0.1 untuk lingkungan pengembangan)
DB_HOST=localhost

# Nama pengguna (username) untuk autentikasi ke basis data
DB_USER=root

# Kata sandi (password) untuk autentikasi basis data (kosongkan jika tanpa password)
DB_PASS=

# Nama basis data yang digunakan oleh aplikasi
DB_NAME=db_opensrc

# Port utama koneksi basis data (default MySQL: 3306)
DB_PORT=3306

# Port cadangan/alternatif jika port utama bentrok atau tidak dapat diakses (fallback)
DB_FALLBACK_PORT=3307

# Waktu tunggu batas maksimal koneksi dalam milidetik (timeout)
DB_CONNECT_TIMEOUT=3000

